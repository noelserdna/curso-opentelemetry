# Modo zero-code: toda la configuración va por variables de entorno.
OTEL_SERVICE_NAME=tienda
OTEL_TRACES_EXPORTER=console
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# Menos atributos de recurso (host, proceso, nube…) para que el span se lea mejor en la terminal.
OTEL_NODE_RESOURCE_DETECTORS=env
# Solo las librerías que usa la tienda.
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http,express
